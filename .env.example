# Client auth flag (Next.js). Falls back from VITE_AUTH_ENABLED when unset.
# NEXT_PUBLIC_AUTH_ENABLED=true

# Get a key at https://console.x.ai — do not commit the real value.
XAI_API_KEY=xai-your-key-here

# eBay Finding API app ID for sold comps (optional).
# EBAY_APP_ID=YourAppId

# Stripe Pro billing (optional until you enable payments).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required on Vercel for accounts. Copy the pooled URI from the Neon project.
# DATABASE_URL=postgresql://...
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://thecardbinder.vercel.app
