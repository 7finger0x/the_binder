# Client auth flag (Next.js). Falls back from VITE_AUTH_ENABLED when unset.
# NEXT_PUBLIC_AUTH_ENABLED=true

# Get a key at https://console.x.ai — do not commit the real value.
XAI_API_KEY=xai-your-key-here

# eBay Finding API app ID for sold comps (optional).
# EBAY_APP_ID=YourAppId

# PriceCharting API token for sports card estimates (optional).
# PRICECHARTING_API_TOKEN=your-token-here

# Stripe Pro billing (optional until you enable payments).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Required on Vercel for accounts. Prefer the **non-pooled** Neon URI for migrations
# (Vercel/Neon integrations expose this as POSTGRES_URL_NON_POOLING). The migrator
# rewrites pooled hostnames when needed, but setting the direct URL is safest.
# DATABASE_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://thecardbinder.vercel.app

# --- Vercel / Neon ---
# Production builds run `npm run db:migrate` before `next build`. The GitHub-linked
# Vercel project must expose POSTGRES_URL_NON_POOLING (or DATABASE_URL). If GitHub
# shows failed deploys on one Vercel team while `vercel deploy` succeeds on another,
# consolidate to a single Vercel project or attach Neon env vars to the project
# that serves your production domain.
